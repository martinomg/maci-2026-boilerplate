{
  "name": "@maci/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm cesium:assets && next build",
    "cesium:assets": "node scripts/copy-cesium-assets.mjs",
    "dev": "pnpm cesium:assets && next dev --hostname 0.0.0.0",
    "lint": "eslint .",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "index:blog": "tsx scripts/index-blog.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "cesium": "^1.144.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
