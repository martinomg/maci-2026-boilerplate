# Copy this file to api/.env with bin/env.init.command.sh.
# api/.env is local-only and ignored by Git.

COMPOSE_PROJECT_NAME=maci-boilerplate

POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=directus
POSTGRES_PORT=18701

DIRECTUS_KEY=change-me-directus-key
DIRECTUS_SECRET=change-me-directus-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
DIRECTUS_PORT=18707
DIRECTUS_PUBLIC_URL=http://localhost:18707

QDRANT_TCP_PORT=18703
QDRANT_GRPC_PORT=18704

NEXT_PORT=18708
NEXT_PUBLIC_SITE_URL=http://localhost:18708
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:18707

