# Copy this file to api/.env with bin/env.init.command.sh.
# api/.env is local-only and ignored by Git.

COMPOSE_PROJECT_NAME=maci-boilerplate

POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=directus
POSTGRES_PORT=18701

DIRECTUS_KEY=change-me-directus-key
DIRECTUS_SECRET=change-me-directus-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# Static token for the seeded app service user (Internal User role). Generated locally; never commit a real value.
DIRECTUS_SERVICE_TOKEN=change-me-service-token
# Static token for the seeded configurator service user (Configurator role), used by the SVG layout upload.
DIRECTUS_CONFIGURATOR_TOKEN=change-me-configurator-token
DIRECTUS_PORT=18707
DIRECTUS_PUBLIC_URL=http://localhost:18707

QDRANT_TCP_PORT=18703
QDRANT_GRPC_PORT=18704

# Search embeddings. Keep 'local' for the deterministic demo vector that needs no API key.
# Set 'openai' plus a key to use a hosted OpenAI-compatible embeddings endpoint,
# then rebuild the index with pnpm search:index. Never commit a real key.
EMBEDDING_PROVIDER=local
# EMBEDDING_API_KEY=change-me-embedding-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSIONS=1536

NEXT_PORT=18708
NEXT_PUBLIC_SITE_URL=http://localhost:18708
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:18707

